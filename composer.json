{
  "name": "labm/wordpress-site",
  "description": "Calidad y pruebas del sitio WordPress LABM.",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "phpstan/phpstan": "1.12.26",
    "phpunit/phpunit": "11.5.27",
    "szepeviktor/phpstan-wordpress": "1.3.5",
    "wp-coding-standards/wpcs": "3.2.0"
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "analyse": "phpstan analyse"
  }
}
