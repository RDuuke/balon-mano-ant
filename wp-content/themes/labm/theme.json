{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "palette": [
        { "slug": "verde-labm", "name": "Verde LABM", "color": "#AECD25" },
        { "slug": "verde-oscuro-labm", "name": "Verde oscuro LABM", "color": "#789614" },
        { "slug": "negro-labm", "name": "Negro LABM", "color": "#202020" },
        { "slug": "neutro-labm", "name": "Neutro LABM", "color": "#F3F6E8" },
        { "slug": "blanco", "name": "Blanco", "color": "#ffffff" }
      ]
    },
    "typography": { "fluid": true },
    "custom": {
      "labm": {
        "layout": {
          "contentMax": "1200px",
          "gutter": "clamp(1rem, 3vw, 2rem)"
        },
        "spacing": {
          "small": "clamp(.5rem, 1vw, .75rem)",
          "medium": "clamp(1rem, 2vw, 1.5rem)",
          "large": "clamp(1.5rem, 4vw, 3rem)"
        },
        "radius": ".75rem"
      }
    }
  },
  "styles": {
    "typography": { "fontFamily": "system-ui, sans-serif", "lineHeight": "1.6" },
    "elements": { "link": { "color": { "text": "var:preset|color|negro-labm" } } }
  }
}
