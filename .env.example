# DEMO LABM - FICTICIO. Copie como .env y cambie solo valores locales.
DB_NAME=labm_demo
DB_USER=labm_demo
DB_PASSWORD=demo_password_change_me
DB_ROOT_PASSWORD=demo_root_password_change_me
WP_PORT=8080
WP_URL=http://localhost:8080
WP_TITLE=LABM Demo Ficticio
WP_ADMIN_USER=labm_demo_admin
WP_ADMIN_PASSWORD=demo_admin_password_change_me
WP_ADMIN_EMAIL=demo@example.invalid

# Autor de paquetes de contenido (opcional).
# CONTENT_SYNC_OWNER=nombre-del-desarrollador

# Solo local, desarrollo o staging: configure en el archivo .env no versionado
# hasta dos copias internas separadas por comas para el formulario de Contacto.
# No defina LABM_CONTACT_TEST_RECIPIENTS en produccion.
# LABM_CONTACT_TEST_RECIPIENTS=
