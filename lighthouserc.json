{
  "ci": {
    "collect": {
      "url": ["http://localhost:8080/"],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0 }],
        "categories:accessibility": ["warn", { "minScore": 0 }],
        "categories:best-practices": ["warn", { "minScore": 0 }],
        "categories:seo": ["warn", { "minScore": 0 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "artifacts/lighthouse" }
  },
  "temporary-public-storage": false
}
